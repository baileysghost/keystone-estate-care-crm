# Required on Vercel. Set a PostgreSQL pooler URI here or use POSTGRES_URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for hosted or connected workspaces. Use a unique password of 16+ characters.
CRM_WORKSPACE_PASSWORD=

# ── Hermes Agent Integration ────────────────────────────────────────────────
# Bearer token for the automation agent. Generate a secure random string
# (e.g. openssl rand -hex 32) and share it ONLY with the automation agent.
# Never commit this value to GitHub.
HERMES_API_KEY=
# Set to 'false' to temporarily disable lead/attorney ingestion.
HERMES_INGESTION_ENABLED=true
# Set to 'true' once the hermes schema migration has been applied.
HERMES_MIGRATION_APPLIED=false
